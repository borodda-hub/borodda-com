---
---
<dialog class="lightbox" aria-label="Image viewer">
  <button class="lightbox-close" type="button" aria-label="Close image viewer">Close</button>
  <img class="lightbox-img" alt="" />
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  const lbImg = dialog?.querySelector<HTMLImageElement>('.lightbox-img');
  const closeBtn = dialog?.querySelector<HTMLButtonElement>('.lightbox-close');

  function largestSrc(el: HTMLImageElement): string {
    const srcset = el.getAttribute('srcset');
    if (!srcset) return el.currentSrc || el.src;
    const sources = srcset
      .split(',')
      .map((s) => {
        const parts = s.trim().split(/\s+/);
        const w = parseInt(parts[1] ?? '0', 10) || 0;
        return { url: parts[0], w };
      })
      .filter((s) => s.url);
    sources.sort((a, b) => b.w - a.w);
    return sources[0]?.url || el.currentSrc || el.src;
  }

  const targets = document.querySelectorAll<HTMLImageElement>(
    '.case-hero img, .rich-text img, .case-gallery img'
  );
  targets.forEach((el) => {
    el.classList.add('lightbox-trigger');
    el.addEventListener('click', () => {
      if (!dialog || !lbImg) return;
      lbImg.src = largestSrc(el);
      lbImg.alt = el.alt || '';
      dialog.showModal();
    });
  });

  closeBtn?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  dialog?.addEventListener('close', () => {
    if (lbImg) lbImg.src = '';
  });
</script>

<style is:global>
  .lightbox-trigger { cursor: zoom-in; }

  /* The viewer is always dark, in both themes. */
  .lightbox {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    width: 100%;
    height: 100%;
    margin: 0;
    color: #EDEDEA;
  }
  .lightbox::backdrop { background: rgba(16, 17, 19, 0.96); }
  .lightbox[open] { display: flex; align-items: center; justify-content: center; }
  .lightbox-img {
    display: block;
    max-width: 92vw;
    max-height: 92vh;
    width: auto;
    height: auto;
  }
  .lightbox-close {
    position: fixed;
    top: 8px;
    right: var(--edge);
    min-height: 44px;
    min-width: 44px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: #EDEDEA;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
    text-decoration-color: #5E6168;
  }
  .lightbox-close:hover { color: #86A2FF; text-decoration-color: #86A2FF; }
  .lightbox-close:focus-visible { outline: 2px solid #86A2FF; outline-offset: 2px; }
</style>
