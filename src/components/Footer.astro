---
import { SITE, PROFILES } from '../config';
const year = new Date().getFullYear();
---
<footer class="wrap">
  <div class="foot meta">
    <span>© {year} {SITE.name}</span>
    <div class="links">
      <a href={PROFILES.orcid} rel="me noopener" target="_blank">ORCID</a>
      <a href={PROFILES.scholar} rel="noopener" target="_blank">Google Scholar</a>
      <a href={PROFILES.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
      <a href="/feed.xml">RSS</a>
    </div>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--strong);
    padding-block: 14px 40px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 32px;
  }
  .foot .links { font-family: var(--mono); font-size: 12px; font-weight: 400; letter-spacing: .04em; }
</style>
