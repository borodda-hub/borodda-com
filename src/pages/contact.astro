---
import Layout from '../layouts/Layout.astro';
import { EMAILS } from '../config';
---
<Layout
  title="Contact — Bo Rodda"
  description="Three pathways: academic and research, partnership, and press and speaking."
>
  <div class="wrap">
    <header class="pagehead">
      <h1 class="display">Contact</h1>
      <p class="pagelead">Three pathways. Use the one that fits.</p>
    </header>

    <section class="sec" aria-label="Contact pathways">
      <div class="paths">
        <div class="path">
          <h2 class="meta">Academic / Research</h2>
          <a class="mail" href={`mailto:${EMAILS.academic}`}>{EMAILS.academic}</a>
          <p>
            For collaborations, references, graduate-student inquiries, conference
            invitations, and review requests.
          </p>
        </div>

        <div class="path">
          <h2 class="meta">Partnership</h2>
          <a class="mail" href={`mailto:${EMAILS.partnership}`}>{EMAILS.partnership}</a>
          <p>
            For industry, civic, and cultural partnerships through Illinois Tech
            or independently. See <a class="lnk" href="/practice/">Practice</a> for
            context.
          </p>
        </div>

        <div class="path">
          <h2 class="meta">Press and Speaking</h2>
          <a class="mail" href={`mailto:${EMAILS.press}`}>{EMAILS.press}</a>
          <p>For interviews, talks, panels, and quotation requests.</p>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .sec { border-top: 0; padding-top: 0; }
  .paths { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px var(--gap); }
  .path { border-top: 1px solid var(--strong); padding-top: 12px; display: flex; flex-direction: column; gap: 6px; }
  .path h2 { font-weight: 400; }
  .mail {
    font-size: clamp(18px, 1.7vw, 26px);
    font-weight: 500;
    letter-spacing: -0.02em;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    overflow-wrap: anywhere;
  }
  .path p { font-size: 16px; line-height: 1.5; max-width: 40ch; margin-top: 8px; }
  @media (max-width: 760px) {
    .paths { grid-template-columns: minmax(0, 1fr); }
  }
</style>
