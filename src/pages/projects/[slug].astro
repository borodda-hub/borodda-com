---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Lightbox from '../../components/Lightbox.astro';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;

const labelize = (s: string) =>
  s.split('-').map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
const statusLabel = data.status.charAt(0).toUpperCase() + data.status.slice(1);
const ogImage = data.heroImage?.src;
const hasCredits = data.credits.length > 0 || data.funding.length > 0 || data.press.length > 0;
---
<Layout
  title={`${data.title} — Bo Rodda`}
  description={data.excerpt}
  ogType="article"
  ogImage={ogImage}
>
  <article class="wrap case-study">
    <header class="pagehead">
      <p class="meta crumb"><a href="/projects/">Work</a></p>
      <h1 class="display sm">{data.title}</h1>
      <p class="pagelead">{data.subtitle}</p>
    </header>

    {data.heroImage && (
      <div class="case-hero">
        <Image
          src={data.heroImage}
          alt={data.heroImageAlt ?? ''}
          widths={[720, 1080, 1620, 2400]}
          sizes="(min-width: 1680px) 1600px, 100vw"
          loading="eager"
        />
      </div>
    )}

    <div class:list={['two', 'case-body', { 'has-gallery': data.gallery.length > 0 }]}>
      <dl class="kv case-meta">
        <dt>Years</dt><dd>{data.dateDisplay}</dd>
        <dt>Status</dt><dd>{statusLabel}</dd>
        {data.category && (<><dt>Category</dt><dd>{data.category}</dd></>)}
        {data.partners.length > 0 && (<><dt>Partners</dt><dd>{data.partners.join(', ')}</dd></>)}
        {data.themes.length > 0 && (<><dt>Themes</dt><dd>{data.themes.map(labelize).join(', ')}</dd></>)}
      </dl>

      <div class="rich-text case-text">
        <Content />
      </div>

      {data.gallery.length > 0 && (
        <aside class="case-gallery" aria-label="Project gallery">
          {data.gallery.map((g) => (
            <figure class="gallery-item">
              <Image
                src={g.src}
                alt={g.alt}
                widths={[320, 480, 720, 1080]}
                sizes="(min-width: 961px) 24vw, 100vw"
                loading="lazy"
              />
              {g.caption && <figcaption>{g.caption}</figcaption>}
            </figure>
          ))}
        </aside>
      )}
    </div>

    <Lightbox />

    {hasCredits && (
      <footer class="sec">
        <div class="sechead">
          <h2>Credits</h2>
        </div>
        <div class="two">
          {data.credits.length > 0 && (
            <dl class="kv wide main">
              {data.credits.map((c) => (
                <>
                  <dt>{c.role}</dt>
                  <dd>{c.name} <span class="credit-aff">/ {c.affiliation}</span></dd>
                </>
              ))}
            </dl>
          )}
          {data.funding.length > 0 && (
            <div class="main">
              <h3 class="sub">Funding</h3>
              <ul class="plain">
                {data.funding.map((f) => <li>{f}</li>)}
              </ul>
            </div>
          )}
          {data.press.length > 0 && (
            <div class="main">
              <h3 class="sub">Selected coverage</h3>
              {data.press.map((p) => (
                <p class="cite">
                  {p.url
                    ? <a href={p.url} target="_blank" rel="noopener">{p.citation}</a>
                    : p.citation}
                </p>
              ))}
            </div>
          )}
        </div>
      </footer>
    )}
  </article>
</Layout>

<style>
  .case-hero { background: var(--tile); }
  .case-hero :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    max-height: 82vh;
    object-fit: cover;
  }

  .case-body { padding-block: 56px 120px; align-items: start; }
  .case-meta { grid-column: span 3; }
  .case-text { grid-column: 4 / span 8; }
  .has-gallery .case-text { grid-column: 4 / span 6; }
  .case-gallery { grid-column: 10 / span 3; display: grid; gap: 24px; align-content: start; }

  .gallery-item :global(img) {
    width: 100%;
    height: auto;
    background: var(--tile);
    transition: filter .24s ease;
  }
  .gallery-item :global(img):hover { filter: contrast(1.05) saturate(1.05); }
  .gallery-item figcaption {
    margin-top: 8px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: .03em;
    line-height: 1.5;
    color: var(--muted);
  }

  .credit-aff { color: var(--muted); }
  .cite { overflow-wrap: anywhere; }

  @media (max-width: 960px) {
    .case-body { padding-block: 40px 72px; }
    .case-meta, .case-text, .has-gallery .case-text, .case-gallery { grid-column: 1 / -1; }
    .case-gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gap); }
  }
  @media (max-width: 600px) {
    .case-gallery { grid-template-columns: minmax(0, 1fr); }
  }
</style>
