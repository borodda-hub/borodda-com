---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { CATEGORIES } from '../../config';

const projects = await getCollection('projects');
projects.sort((a, b) => b.data.date.localeCompare(a.data.date));

const labelize = (s: string) =>
  s.split('-').map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
const statusLabel = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const pad = (n: number) => String(n).padStart(2, '0');

const projectsForView = projects.map((p) => {
  const year = parseInt(p.data.date.split('-')[0], 10);
  const decade = `${Math.floor(year / 10) * 10}s`;
  return { id: p.id, data: p.data, decade, href: `/projects/${p.id}/` };
});

const count = (fn: (p: (typeof projectsForView)[number]) => boolean) => projectsForView.filter(fn).length;

const groups = [
  {
    type: 'category',
    label: 'Category',
    options: CATEGORIES.filter((c) => projects.some((p) => p.data.category === c)).map((c) => ({
      value: slugify(c),
      label: c,
      n: count((p) => p.data.category === c),
    })),
  },
  {
    type: 'theme',
    label: 'Theme',
    options: Array.from(new Set(projects.flatMap((p) => p.data.themes))).sort().map((t) => ({
      value: t,
      label: labelize(t),
      n: count((p) => p.data.themes.includes(t)),
    })),
  },
  {
    type: 'decade',
    label: 'Decade',
    options: Array.from(new Set(projectsForView.map((p) => p.decade))).sort().map((d) => ({
      value: d,
      label: d,
      n: count((p) => p.decade === d),
    })),
  },
  {
    type: 'status',
    label: 'Status',
    options: Array.from(new Set(projects.map((p) => p.data.status))).sort().map((s) => ({
      value: s,
      label: statusLabel(s),
      n: count((p) => p.data.status === s),
    })),
  },
].filter((g) => g.options.length > 0);
---
<Layout
  title="Work — Bo Rodda"
  description="Selected projects across data visualization, urban computing, design research, and interactive installation."
>
  <div class="wrap">
    <header class="pagehead">
      <h1 class="display">Work</h1>
      <p class="pagelead">
        Selected projects across data visualization, urban computing, interactive
        installation, and design research. Filter by category, theme, decade, or
        status — the URL updates so any filtered view is shareable.
      </p>
    </header>

    <section class="sec" aria-labelledby="h-index">
      <div class="sechead">
        <h2 id="h-index"><span class="num">{pad(projects.length)}</span>Index of projects</h2>
        <button type="button" class="more lnk filter-clear" hidden>Clear filters</button>
      </div>

      <div class="work">
        <div class="filters" aria-label="Filter projects">
          {groups.map((g) => (
            <div class="filter-group">
              <p class="sub">{g.label}</p>
              <ul class="filter-list">
                {g.options.map((o) => (
                  <li>
                    <button
                      type="button"
                      class="pill"
                      data-type={g.type}
                      data-value={o.value}
                      aria-pressed="false"
                    ><span>{o.label}</span><span class="ct">{pad(o.n)}</span></button>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <div class="results">
          <ul class="cards projects-grid">
            {projectsForView.map((p) => (
              <li>
                <a
                  href={p.href}
                  class="card project-tile"
                  data-category={p.data.category ? slugify(p.data.category) : ''}
                  data-themes={p.data.themes.join(' ')}
                  data-decade={p.decade}
                  data-status={p.data.status}
                >
                  {p.data.heroImage ? (
                    <Image
                      src={p.data.heroImage}
                      alt={p.data.heroImageAlt ?? ''}
                      widths={[400, 640, 960]}
                      sizes="(min-width: 961px) 24vw, (min-width: 601px) 48vw, 100vw"
                      loading="lazy"
                    />
                  ) : (
                    <span class="ph" aria-hidden="true"></span>
                  )}
                  <h3>{p.data.title}</h3>
                  <span class="meta">{[p.data.dateDisplay, p.data.category].filter(Boolean).join(' / ')}</span>
                  <p class="tile-excerpt">{p.data.excerpt}</p>
                </a>
              </li>
            ))}
          </ul>
          <p class="empty projects-empty" hidden>No projects match the current filters.</p>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  type FilterType = 'category' | 'theme' | 'decade' | 'status';
  const TYPES: FilterType[] = ['category', 'theme', 'decade', 'status'];

  const params = new URLSearchParams(location.search);
  const active = Object.fromEntries(
    TYPES.map((t) => [t, new Set(params.getAll(t))])
  ) as Record<FilterType, Set<string>>;

  const pills = document.querySelectorAll<HTMLButtonElement>('.pill');
  const tiles = document.querySelectorAll<HTMLLIElement>('.projects-grid > li');
  const empty = document.querySelector<HTMLElement>('.projects-empty');
  const clearBtn = document.querySelector<HTMLButtonElement>('.filter-clear');

  function syncPills() {
    pills.forEach((btn) => {
      const type = btn.dataset.type as FilterType;
      btn.setAttribute('aria-pressed', String(active[type].has(btn.dataset.value as string)));
    });
    if (clearBtn) clearBtn.hidden = !TYPES.some((t) => active[t].size > 0);
  }

  function applyFilters() {
    let visible = 0;
    tiles.forEach((li) => {
      const a = li.querySelector<HTMLAnchorElement>('.project-tile');
      if (!a) return;
      const values: Record<FilterType, string[]> = {
        category: [a.dataset.category ?? ''],
        theme: (a.dataset.themes || '').split(' ').filter(Boolean),
        decade: [a.dataset.decade ?? ''],
        status: [a.dataset.status ?? ''],
      };
      const show = TYPES.every(
        (t) => active[t].size === 0 || values[t].some((v) => active[t].has(v))
      );
      li.hidden = !show;
      if (show) visible++;
    });
    if (empty) empty.hidden = visible > 0;
  }

  function syncURL() {
    const np = new URLSearchParams();
    TYPES.forEach((t) => active[t].forEach((v) => np.append(t, v)));
    const qs = np.toString();
    history.replaceState(null, '', qs ? `${location.pathname}?${qs}` : location.pathname);
  }

  pills.forEach((btn) => {
    btn.addEventListener('click', () => {
      const type = btn.dataset.type as FilterType;
      const value = btn.dataset.value as string;
      if (active[type].has(value)) active[type].delete(value);
      else active[type].add(value);
      syncPills();
      applyFilters();
      syncURL();
    });
  });

  clearBtn?.addEventListener('click', () => {
    TYPES.forEach((t) => active[t].clear());
    syncPills();
    applyFilters();
    syncURL();
  });

  syncPills();
  applyFilters();
</script>

<style>
  .work { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 56px var(--gap); }
  .filters { grid-column: span 3; display: grid; gap: 40px; align-content: start; }
  .results { grid-column: span 9; }

  .filter-list { list-style: none; padding: 0; }
  .pill {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    min-height: 44px;
    padding-block: 10px;
    border-top: 1px solid var(--rule);
    font-size: 16px;
    font-weight: 500;
    text-align: left;
    color: var(--muted);
  }
  .filter-list li:first-child .pill { border-top: 1px solid var(--strong); }
  .pill .ct { font-family: var(--mono); font-size: 12px; font-weight: 400; }
  .pill:hover { color: var(--accent); }
  /* selected: ink text and a marker, no fill */
  .pill[aria-pressed='true'] { color: var(--ink); }
  .pill[aria-pressed='true'] > span:first-child::before { content: '● '; color: var(--accent); font-size: .6em; vertical-align: .2em; }
  .filter-clear { min-height: 44px; }

  .projects-grid { list-style: none; padding: 0; }
  .tile-excerpt { font-size: 15px; line-height: 1.45; margin-top: 8px; color: var(--ink); }
  a.card:hover .tile-excerpt { color: var(--ink); }

  @media (max-width: 960px) {
    .filters, .results { grid-column: 1 / -1; }
    .filters { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px var(--gap); }
  }
  @media (max-width: 600px) {
    .filters { grid-template-columns: minmax(0, 1fr); }
  }
</style>
