---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Lightbox from '../../components/Lightbox.astro';

export async function getStaticPaths() {
  const entries = await getCollection('researchStrands');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;

const projects = await getCollection('projects');
const publications = await getCollection('publications');
const talks = await getCollection('talks');

const relatedProjects = data.relatedProjects
  .map((slug) => projects.find((p) => p.id === slug))
  .filter((p): p is (typeof projects)[number] => Boolean(p));
const relatedPubs = data.relatedPublications
  .map((slug) => publications.find((p) => p.id === slug))
  .filter((p): p is (typeof publications)[number] => Boolean(p));
const relatedTalks = data.relatedTalks
  .map((slug) => talks.find((t) => t.id === slug))
  .filter((t): t is (typeof talks)[number] => Boolean(t));
---
<Layout
  title={`${data.title} — Bo Rodda`}
  description={data.summary}
  ogType="article"
>
  <article class="wrap strand-page">
    <header class="pagehead">
      <p class="meta crumb"><a href="/research/">Research</a></p>
      <h1 class="display sm">{data.title}</h1>
      <p class="pagelead">{data.summary}</p>
    </header>

    <div class="sec body">
      <div class="rich-text offset">
        <Content />
      </div>
    </div>

    <Lightbox />

    {relatedProjects.length > 0 && (
      <section class="sec">
        <div class="sechead"><h2>Related projects</h2></div>
        <div class="cards">
          {relatedProjects.map((p) => (
            <a href={`/projects/${p.id}/`} class="card">
              {p.data.heroImage ? (
                <Image
                  src={p.data.heroImage}
                  alt={p.data.heroImageAlt ?? ''}
                  widths={[400, 640, 960]}
                  sizes="(min-width: 961px) 32vw, (min-width: 601px) 48vw, 100vw"
                  loading="lazy"
                />
              ) : (
                <span class="ph" aria-hidden="true"></span>
              )}
              <h3>{p.data.title}</h3>
              <span class="meta">{p.data.dateDisplay}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {relatedPubs.length > 0 && (
      <section class="sec">
        <div class="sechead"><h2>Related publications</h2></div>
        <div class="offset list">
          {relatedPubs.map((p) => (
            <p class="cite">
              {p.data.authors} ({p.data.year}). {p.data.title}. {p.data.venue}.
              {(p.data.doi || p.data.url) && (
                <>{' '}<a
                  href={p.data.doi ? `https://doi.org/${p.data.doi}` : p.data.url}
                  target="_blank"
                  rel="noopener"
                >{p.data.doi ? 'DOI' : 'Read'}</a></>
              )}
            </p>
          ))}
        </div>
      </section>
    )}

    {relatedTalks.length > 0 && (
      <section class="sec">
        <div class="sechead"><h2>Related talks</h2></div>
        <div class="offset list">
          {relatedTalks.map((t) => (
            <p class="cite">
              {t.data.title}
              <span class="tag">{t.data.venue} / {t.data.location} / {t.data.date}</span>
            </p>
          ))}
        </div>
      </section>
    )}
  </article>
</Layout>

<style>
  .body { padding-top: 56px; }
  .list { max-width: calc(var(--measure) + 12ch); }
  .list .cite { font-size: 16px; }
</style>
