---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const strands = await getCollection('researchStrands');
strands.sort((a, b) => a.data.order - b.data.order);

const projects = await getCollection('projects');
const publications = await getCollection('publications');

type RelatedItem = { kind: 'Project' | 'Publication'; href: string; label: string; year: string };

function relatedFor(strand: (typeof strands)[number]): RelatedItem[] {
  const items: RelatedItem[] = [];
  for (const slug of strand.data.relatedProjects) {
    const p = projects.find((x) => x.id === slug);
    if (p) {
      items.push({ kind: 'Project', href: `/projects/${p.id}/`, label: p.data.title, year: p.data.dateDisplay });
    }
  }
  for (const slug of strand.data.relatedPublications) {
    const p = publications.find((x) => x.id === slug);
    if (p) {
      items.push({
        kind: 'Publication',
        href: p.data.url ?? (p.data.doi ? `https://doi.org/${p.data.doi}` : '/writing/'),
        label: p.data.title,
        year: String(p.data.year),
      });
    }
  }
  return items.slice(0, 3);
}
---
<Layout
  title="Research — Bo Rodda"
  description="Five research strands: game studies and decision quality, visualization, urban computing, experiential media, and industry-engaged pedagogy."
>
  <div class="wrap">
    <header class="pagehead">
      <h1 class="display">Research</h1>
      <p class="pagelead">
        Five overlapping strands. They cite each other often — visualization
        is the medium that translates the urban-computing simulations; the
        decision-quality work began as a way of evaluating game environments
        and is now applied to dashboards and planning tools; the
        industry-engaged pedagogy strand is where the others get tested with
        students and partners.
      </p>
    </header>

    {strands.map((s, i) => {
      const related = relatedFor(s);
      return (
        <section class="sec strand" aria-labelledby={`h-${s.id}`}>
          <div class="sechead">
            <p class="label"><span class="num">{String(i + 1).padStart(2, '0')}</span>{i === 0 ? 'Primary field' : 'Strand'}</p>
            <a class="more lnk" href={`/research/${s.id}/`}>Read the strand</a>
          </div>
          <div class="two">
            <div class="strand-main">
              <h2 class="lead" id={`h-${s.id}`}><a href={`/research/${s.id}/`}>{s.data.title}</a></h2>
              <p class="strand-summary">{s.data.summary}</p>
            </div>
            {related.length > 0 && (
              <div class="strand-related">
                <p class="sub">Featured work</p>
                <ul class="related-list">
                  {related.map((r) => (
                    <li>
                      <a href={r.href}>
                        <span>{r.label}</span>
                        <span class="tag">{r.kind} / {r.year}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </section>
      );
    })}
  </div>
</Layout>

<style>
  .strand-main { grid-column: span 7; }
  .strand-related { grid-column: 9 / span 4; }
  .strand-summary { margin-top: 24px; font-size: 18px; line-height: 1.5; max-width: 60ch; }

  .related-list li a {
    display: block;
    padding-block: 12px;
    border-top: 1px solid var(--rule);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.35;
  }
  .related-list li:first-child a { border-top: 1px solid var(--strong); }

  @media (max-width: 960px) {
    .strand-main, .strand-related { grid-column: 1 / -1; }
  }
</style>
