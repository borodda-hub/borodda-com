---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { readingTime } from '../../lib/readingTime';

const publications = await getCollection('publications');
const essays = await getCollection('essays', ({ data }) => !data.draft);

publications.sort((a, b) => b.data.year - a.data.year);
essays.sort((a, b) => b.data.date.localeCompare(a.data.date));

type PubGroup = {
  label: string;
  match: (data: (typeof publications)[number]['data']) => boolean;
};

const pubGroups: PubGroup[] = [
  {
    label: 'Peer-Reviewed Journal Articles',
    match: (d) => d.status === 'published' && d.type === 'journal',
  },
  {
    label: 'Peer-Reviewed Conference Papers',
    match: (d) => d.status === 'published' && d.type === 'conference',
  },
  {
    label: 'Book Chapters',
    match: (d) => d.status === 'published' && d.type === 'chapter',
  },
  {
    label: 'Reviews',
    match: (d) => d.status === 'published' && d.type === 'review',
  },
  {
    label: 'Under Review',
    match: (d) => d.status === 'under-review',
  },
  {
    label: 'In Preparation',
    match: (d) => d.status === 'in-prep',
  },
];

const groupedPubs = pubGroups
  .map((g) => ({ ...g, items: publications.filter((p) => g.match(p.data)) }))
  .filter((g) => g.items.length > 0);

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

function formatDate(d: string): string {
  // Anchor noon UTC to avoid timezone-induced day shifts
  return dateFormatter.format(new Date(`${d}T12:00:00Z`));
}
const pad = (n: number) => String(n).padStart(2, '0');
---
<Layout title="Writing — Bo Rodda" description="Publications and essays by Bo Rodda.">
  <div class="wrap">
    <header class="pagehead">
      <h1 class="display">Writing</h1>
      <p class="pagelead">Peer-reviewed publications above, essays below.</p>
    </header>

    <section class="sec" aria-labelledby="h-pubs">
      <div class="sechead">
        <h2 id="h-pubs"><span class="num">01</span>Publications</h2>
        <span class="meta">{pad(publications.length)} entries</span>
      </div>
      {groupedPubs.length === 0 && <p class="empty">No publications listed yet.</p>}
      <div class="groups">
        {groupedPubs.map((g) => (
          <div class="two group">
            <h3 class="sub aside">{g.label}</h3>
            <div class="main">
              {g.items.map((p) => (
                <p class="cite">
                  {p.data.featured && <span class="mark" aria-hidden="true">● </span>}
                  {p.data.authors} ({p.data.year}). {p.data.title}. {p.data.venue}.
                  {(p.data.doi || p.data.url) && (
                    <>{' '}<a
                      href={p.data.doi ? `https://doi.org/${p.data.doi}` : p.data.url}
                      target="_blank"
                      rel="noopener"
                    >{p.data.doi ? 'DOI' : 'Read'}</a></>
                  )}
                </p>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="sec" aria-labelledby="h-essays">
      <div class="sechead">
        <h2 id="h-essays"><span class="num">02</span>Essays</h2>
        <a class="more lnk" href="/feed.xml">RSS</a>
      </div>
      <div class="two">
        <div class="main">
          {essays.length === 0 ? (
            <p class="empty">No essays yet — the first ones land here when written.</p>
          ) : (
            essays.map((e) => (
              <a class="essay" href={`/writing/essays/${e.id}/`}>
                <h3>{e.data.title}</h3>
                {e.data.subtitle && <p class="essay-subtitle">{e.data.subtitle}</p>}
                <p>{e.data.excerpt}</p>
                <span class="meta">{formatDate(e.data.date)} · {readingTime(e.body)} min read</span>
              </a>
            ))
          )}
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .groups { display: grid; gap: 56px; }
  .group { row-gap: 12px; }
  .group .sub { margin: 0; padding-top: 16px; }
  .main .cite { font-size: 16px; max-width: 80ch; }
  .mark { color: var(--accent); font-size: .6em; vertical-align: .25em; }

  .essay { display: block; padding-block: 18px 22px; border-top: 1px solid var(--rule); max-width: 80ch; }
  .essay:first-of-type { border-top: 1px solid var(--strong); }
  .essay h3 {
    font-weight: var(--dw);
    font-size: clamp(22px, 2vw, 32px);
    line-height: 1.05;
    letter-spacing: var(--dls);
    margin-bottom: 8px;
  }
  .essay p { font-size: 16px; line-height: 1.45; margin-bottom: 6px; }
  .essay-subtitle { color: var(--muted); }
  a.essay:hover { color: inherit; }
  a.essay:hover h3 { color: var(--accent); }
</style>
